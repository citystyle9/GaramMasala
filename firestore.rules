rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRecipeState(data) {
      return data.keys().hasAll(['spices']) &&
             data.spices is list &&
             data.spices.size() <= 200 &&
             (!('activeTemplateName' in data) || (data.activeTemplateName is string && data.activeTemplateName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt', 'spices']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.spices is list &&
             data.spices.size() <= 200;
    }

    // Shared active recipe formulation (no login required)
    match /shared/{docId} {
      allow read: if isValidId(docId);
      allow write: if isValidId(docId) && isValidRecipeState(incoming());
    }

    // Shared templates collection (no login required)
    match /sharedTemplates/{templateId} {
      allow read: if isValidId(templateId);
      allow write: if isValidId(templateId) && isValidTemplate(incoming()) && incoming().id == templateId;
      allow delete: if isValidId(templateId);
    }
  }
}
