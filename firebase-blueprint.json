{
  "entities": {
    "SpiceItem": {
      "title": "SpiceItem",
      "description": "An individual spice ingredient with weight and household measures",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the spice",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Urdu name of spice",
          "maxLength": 100
        },
        "englishName": {
          "type": "string",
          "description": "English name of spice",
          "maxLength": 100
        },
        "weightGrams": {
          "type": "number",
          "description": "Weight in grams"
        },
        "householdAmount": {
          "type": "string",
          "description": "Household amount number or fraction",
          "maxLength": 20
        },
        "householdUnit": {
          "type": "string",
          "description": "Household unit",
          "maxLength": 20
        },
        "householdMeasure": {
          "type": "string",
          "description": "Combined display string for household measure",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "weightGrams"]
    },
    "UserRecipeState": {
      "title": "SharedRecipeState",
      "description": "Shared family active spice list and active template name without login required",
      "type": "object",
      "properties": {
        "activeTemplateName": {
          "type": "string",
          "description": "Name of currently loaded template",
          "maxLength": 100
        },
        "spices": {
          "type": "array",
          "description": "List of active spices in recipe order"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated ISO string",
          "maxLength": 50
        }
      },
      "required": ["spices"]
    },
    "RecipeTemplate": {
      "title": "RecipeTemplate",
      "description": "A saved recipe template formulation shared across all devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template ID",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Template name",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 50
        },
        "spices": {
          "type": "array",
          "description": "List of spices saved in this template"
        }
      },
      "required": ["id", "name", "createdAt", "spices"]
    }
  },
  "firestore": {
    "/shared/{docId}": {
      "schema": "SharedRecipeState",
      "description": "Shared live recipe state across family devices"
    },
    "/sharedTemplates/{templateId}": {
      "schema": "RecipeTemplate",
      "description": "Shared recipe templates accessible to family without login"
    }
  }
}
