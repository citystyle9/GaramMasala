rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprint for UserRecipeState
    function isValidRecipeState(data, userId) {
      return data.keys().hasAll(['userId', 'spices']) &&
             data.keys().hasOnly(['userId', 'spices', 'activeTemplateName', 'updatedAt']) &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.spices is list &&
             data.spices.size() <= 150 &&
             (!('activeTemplateName' in data) || (data.activeTemplateName is string && data.activeTemplateName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation blueprint for RecipeTemplate
    function isValidTemplate(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt', 'spices']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'createdAt', 'spices']) &&
             data.id is string && data.id.size() <= 64 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.spices is list &&
             data.spices.size() <= 150;
    }

    // Match /users/{userId}/recipeState/{stateId}
    match /users/{userId}/recipeState/{stateId} {
      allow get: if isOwner(userId) && isValidId(stateId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(stateId) && isValidRecipeState(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(stateId) && isValidRecipeState(incoming(), userId) &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(stateId);
    }

    // Match /users/{userId}/templates/{templateId}
    match /users/{userId}/templates/{templateId} {
      allow get: if isOwner(userId) && isValidId(templateId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(templateId) && isValidTemplate(incoming(), userId) && incoming().id == templateId;
      allow update: if isOwner(userId) && isValidId(templateId) && isValidTemplate(incoming(), userId) &&
                    incoming().userId == existing().userId &&
                    incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(templateId);
    }
  }
}
